# Firebase client config (lib/firebase_options.dart) is generated via
# `flutterfire configure` and is NOT a secret — the real security boundary
# is firestore.rules (see README's Security Notes section).
#
# This file is a placeholder for any future non-Firebase secrets (e.g. a
# payment provider key). Copy to `.env` and fill in as needed.

# PAYMENT_PROVIDER_KEY=your_key_here
